# Copy to .env (gitignored) and fill in locally. Never commit .env.

# SEC EDGAR requires a descriptive User-Agent: "Your Name your-email@example.com".
# Set your own value in .env only. It is never logged or written to traces.
SEC_USER_AGENT=

# Local LLM (Ollama native /api/chat with tool calling)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=false
LLM_TEMPERATURE=0.2

# Optional fallback, used only if Ollama is unreachable or errors
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Paths are relative to the repo root unless absolute
PLAYBOOK_PATH=playbook.yaml
DATA_DIR=data
# Optional, development only: path to a private prose playbook outside the repo
PLAYBOOK_SOURCE=

# Synthetic portfolio size used by the mask layer (dollars are shown as % of this)
SYNTHETIC_PORTFOLIO_VALUE=100000

# Agent frameworks (Phase 5): telemetry and cloud tracing stay OFF. The code forces these at
# startup anyway (options_copilot/multi_agent/privacy.py); they are listed here for clarity.
CREWAI_DISABLE_TELEMETRY=true
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
